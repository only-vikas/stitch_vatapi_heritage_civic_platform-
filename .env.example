# =========================================================
# VATAPI HERITAGE & CIVIC PLATFORM - ENVIRONMENT TEMPLATE
# =========================================================

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
SUPABASE_SECRET_KEY=your_supabase_secret_key
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json

# Next.js Client Exposed Keys (Required for Supabase client-side Auth & Database)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Ollama Local LLM Configuration (Local Development)
OLLAMA_MODEL=deepseek-r1:1.5b
OLLAMA_HOST=http://127.0.0.1:11434

# OpenRouter AI Fallback Model Configuration (Cloud / Render Deployment)
# When Ollama is offline or on cloud environments like Render, these keys activate automatically
NEXT_PUBLIC_OPENROUTER_API_KEY_1="your_openrouter_api_key_1"
NEXT_PUBLIC_OPENROUTER_API_KEY_2="your_openrouter_api_key_2"
OPENROUTER_API_KEY_1="your_openrouter_api_key_1"
OPENROUTER_API_KEY_2="your_openrouter_api_key_2"
OPENROUTER_MODEL="deepseek/deepseek-r1:free"
OPENROUTER_FALLBACK_MODELS="deepseek/deepseek-chat,meta-llama/llama-3.3-70b-instruct:free,google/gemini-2.0-flash-exp:free"
